{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      {
        "groupName": "scoped",
        "elementNamePattern": ["@*", "@*/**"]
      }
    ],
    "groups": [["builtin", "external"], "scoped", ["parent", "sibling", "index"], "unknown"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/pnpm-lock.yaml",
    "**/dist/",
    "**/node_modules/",
    "**/.claude/",
    "**/generated/",
    "**/.wrangler/",
    "**/.alchemy/",
    "results/",
    "runs/",
    "docs/design/"
  ]
}
